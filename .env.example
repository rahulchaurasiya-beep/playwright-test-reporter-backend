PORT=3000

# Database (required)
# URL-encode special chars in password (@ → %40, # → %23)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/rocketium_e2e_runs
# RDS: SSL auto-enabled for rds.amazonaws.com hosts (do not add ?sslmode= to URL)
# DATABASE_SSL=true

# Artifact storage: local (default) or s3
ARTIFACT_STORAGE=local
UPLOADS_DIR=./uploads

# S3 (when ARTIFACT_STORAGE=s3)
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=rocketium-playwright-artifacts
# AWS_S3_PREFIX=artifacts
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ARTIFACT_URL_MODE=proxy
# S3_PRESIGN_EXPIRES_SEC=3600

# JWT auth for dashboard users
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Slack failure alerts (optional)
# Requires the Slack app to have chat:write and be invited to the target channel.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_ALERT_CHANNEL_ID=C0123456789
# REPORTER_PUBLIC_BASE_URL=https://reporter.example.com
# SLACK_MAX_THREAD_REPLIES=20

# Slack ticket ingestion (Phase 1) — DevRev tickets from the support channel
# Found in Slack app settings -> Basic Information -> Signing Secret
# SLACK_SIGNING_SECRET=
# Restrict ingestion to one channel (e.g. #product-support). Leave unset to accept all.
# SLACK_PRODUCT_SUPPORT_CHANNEL_ID=C0123456789
# Only treat messages from the DevRev bot/user id as tickets (optional)
# SLACK_TICKET_BOT_USER_ID=
# Ignore messages from our own bot user id to avoid loops (optional)
# SLACK_SELF_BOT_USER_ID=

# UI dashboard uses JWT on GET/PATCH/POST /api/ui/projects
DATA_DIR=./data
